<?xml version="1.0" encoding="utf-8" ?>

<!-- Define a página principal da lista de produtos -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiappMinhasCompras.Views.ListaProduto"
             Title="Minhas compras">

    <!-- Define os botões que aparecem na barra superior da página -->
    <ContentPage.ToolbarItems>

        <!-- Botão responsável por somar os valores dos produtos -->
        <ToolbarItem 
            Text="Somar" 
            Clicked="ToolbarItem_Clicked_1"/>

        <!-- Botão responsável por adicionar um novo produto -->
        <ToolbarItem
            Text="Adicionar"
            Clicked="ToolbarItem_Clicked" />

    </ContentPage.ToolbarItems>

    <!-- Organiza os elementos da página verticalmente -->
    <VerticalStackLayout>

        <!-- Campo utilizado para pesquisar produtos -->
        <SearchBar
            x:Name="txt_search"
            Placeholder="Busca de produtos"
            TextChanged="txt_search_TextChanged"/>

        <!-- Lista os produtos cadastrados -->
        <ListView x:Name="lst_produtos" ItemSelected="lst_produtos_ItemSelected">

            <!-- Define o cabeçalho da lista -->
            <ListView.Header>
                <Grid ColumnDefinitions="*, *, *, *, *">

                    <!-- Exibe o título da coluna do Id -->
                    <Label
                        Grid.Column="0"
                        Text="ID" />

                    <!-- Exibe o título da coluna da descrição -->
                    <Label
                        Grid.Column="1"
                        Text="Descrição" />

                    <!-- Exibe o título da coluna do preço -->
                    <Label
                        Grid.Column="2"
                        Text="Preço" />

                    <!-- Exibe o título da coluna da quantidade -->
                    <Label
                        Grid.Column="3"
                        Text="QTD" />

                    <!-- Exibe o título da coluna do valor total -->
                    <Label
                        Grid.Column="4"
                        Text="Total" />

                </Grid>
            </ListView.Header>

            <!-- Define como cada produto será exibido -->
            <ListView.ItemTemplate>
                <DataTemplate>

                    <ViewCell>

                        <!-- Define as opções disponíveis para cada produto -->
                        <ViewCell.ContextActions>

                            <!-- Opção para remover o produto -->
                            <MenuItem
                                Text="Remover"
                                Clicked="MenuItem_Clicked" />

                        </ViewCell.ContextActions>

                        <!-- Organiza as informações do produto em colunas -->
                        <Grid ColumnDefinitions="*, *, *, *, *">

                            <!-- Exibe o Id do produto -->
                            <Label
                                Grid.Column="0"
                                Text="{Binding Id}" />

                            <!-- Exibe a descrição do produto -->
                            <Label
                                Grid.Column="1"
                                Text="{Binding Descricao}" />

                            <!-- Exibe o preço do produto -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding Preco}" />

                            <!-- Exibe a quantidade do produto -->
                            <Label
                                Grid.Column="3"
                                Text="{Binding Quantidade}" />

                            <!-- Exibe o valor total do produto -->
                            <Label
                                Grid.Column="4"
                                Text="{Binding Total}" />

                        </Grid>

                    </ViewCell>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </VerticalStackLayout>

</ContentPage>