<?xml version="1.0" encoding="utf-8" ?>

<!-- Define a página principal da lista de produtos -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiappMinhasCompras.Views.ListaProduto"
             Title="Minhas compras">

    <!-- Define os botões que aparecem na barra superior da página -->
    <ContentPage.ToolbarItems>

        <!-- Botão responsável por somar os valores dos produtos -->
        <ToolbarItem 
            Text="Somar" />

        <!-- Botão responsável por adicionar um novo produto -->
        <ToolbarItem
            Text="Adicionar"
            Clicked="ToolbarItem_Clicked" />

    </ContentPage.ToolbarItems>

    <!-- Organiza os elementos da página verticalmente -->
    <VerticalStackLayout>

        <!-- Exibe uma mensagem na tela -->
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>